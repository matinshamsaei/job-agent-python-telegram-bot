# Application
APP_NAME=job-agent
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_JSON=false
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL (SQLAlchemy async URL)
