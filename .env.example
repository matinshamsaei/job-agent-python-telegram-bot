# Application
APP_NAME=job-agent
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_JSON=false
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL (SQLAlchemy async URL, or a raw postgres:// Supabase URI)
DATABASE_URL=postgresql+asyncpg://jobagent:jobagent@localhost:5434/jobagent
# Production on Vercel: Transaction pooler (IPv4). Direct db.<ref>.supabase.co is IPv6-only.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Redis (optional; leave empty on Vercel)
REDIS_URL=redis://localhost:6380/0

# OpenAI (job analysis + on-demand cover letters)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scoring / discovery
SCORE_NOTIFY_THRESHOLD=80
SCORE_APPLY_THRESHOLD=80
SCORE_REVIEW_THRESHOLD=60
EVIDENCE_HALF_LIFE_DAYS=180
HTTP_TIMEOUT_SECONDS=20
COLLECTOR_PAUSE_SECONDS=0.35
DETECT_TIMEOUT_SECONDS=8
DETECT_PAUSE_SECONDS=0.25
DETECT_CONCURRENCY=2
